# Supabase (database + storage + community gallery)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_xxx

# Auth
JWT_SECRET=choose-a-long-random-string

# Admin (gallery moderation + gear admin). Server-only: checked by /api/admin/login,
# never exposed to the browser. Do NOT add a NEXT_PUBLIC_ copy.
ADMIN_PASSWORD=choose-a-strong-password

# PostHog Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Resend Email (optional — cook plan emails)
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=RoughCut BBQ <hello@roughcut.com.au>
NEXT_PUBLIC_SITE_URL=https://app.roughcut.com.au
