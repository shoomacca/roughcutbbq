# Database — Supabase Postgres (primary). Set the pooled connection string.
DATABASE_URL=postgresql://user:password@host:5432/postgres

# Auth — REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=generate-a-long-random-secret

# Admin (gallery moderation) — server-side only, never NEXT_PUBLIC_
ADMIN_PASSWORD=choose-a-strong-password

# PostHog Analytics (optional)
NEXT_PUBLIC_POSTHOG_KEY=your-posthog-key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# Resend Email
RESEND_API_KEY=re_your_resend_api_key
EMAIL_FROM=Rough Cut BBQ <hello@roughcut.com.au>
NEXT_PUBLIC_SITE_URL=https://roughcut.com.au
